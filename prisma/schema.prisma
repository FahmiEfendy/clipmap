// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Auth.js (NextAuth) tables ---
// https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // hashed, only set for credentials sign-up

  accounts Account[]
  sessions Session[]
  places   Place[]
  lists    List[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- Clipmap domain ---

enum ConfidenceTier {
  HIGH
  MEDIUM
  LOW
  NONE
}

enum SourceTier {
  POI_TAG
  CAPTION_VISION
  ESCALATION
  MANUAL
}

model Place {
  id             String         @id @default(cuid())
  tiktokUrl      String
  thumbnailUrl   String?
  name           String
  description    String?
  address        String?
  lat            Float?
  lng            Float?
  placeId        String? // Google Places place_id, used to build the Maps deep link
  category       String?
  confidenceTier ConfidenceTier @default(NONE)
  sourceTier     SourceTier     @default(MANUAL)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lists ListPlace[]
  tags  PlaceTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model List {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  places ListPlace[]

  createdAt DateTime @default(now())
}

model ListPlace {
  listId  String
  placeId String

  list  List  @relation(fields: [listId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@id([listId, placeId])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique

  places PlaceTag[]
}

model PlaceTag {
  placeId String
  tagId   String

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  tag   Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([placeId, tagId])
}
