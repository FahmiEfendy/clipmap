# ============================================================
# CLIPMAP — .env
# ============================================================
# Copy this file to .env and adjust values as needed:
#   cp .env.example .env


# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
# Full connection string, e.g.:
#   postgresql://user:password@host:5432/clipmap?schema=public
DATABASE_URL=


# ------------------------------------------------------------
# Auth.js (NextAuth)
# ------------------------------------------------------------
# Session/JWT signing secret — generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth credentials (Google Cloud Console → OAuth 2.0 Client IDs)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# ------------------------------------------------------------
# Extraction pipeline
# ------------------------------------------------------------
# OpenRouter — vision LLM extraction (Tier 1) and gpt-4o-transcribe (Tier 2)
OPENROUTER_API_KEY=

# A current vision-capable model slug from https://openrouter.ai/models —
# intentionally not defaulted in code, since model slugs/pricing shift often.
# Free-tier option verified to actually support structured output + vision
# together (many free vision models don't, despite claiming to — test with
# `provider: { require_parameters: true }` before trusting one blindly):
# dots-studio/dots-3-note-preview:free
# Free-tier limits: 20 req/min, 50 req/day until $10 lifetime spend on
# OpenRouter, then 1,000/day.
OPENROUTER_VISION_MODEL=

# Google Places API — Find Place / Text Search grounding, used every tier except FALLBACK
GOOGLE_PLACES_API_KEY=


# ------------------------------------------------------------
# Image / thumbnail storage (Backblaze B2, S3-compatible)
# ------------------------------------------------------------
B2_ENDPOINT=
B2_BUCKET=
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
